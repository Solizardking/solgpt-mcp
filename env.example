# PUMP-MCP Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit real keys. .env.local is gitignored.

# --- Primary Solana RPC: keyed Alchemy, then Helius, Tracker last-resort ---
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY
ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Tracker JSON-RPC last-resort. Data API stays on data.solanatracker.io.
SOLANA_TRACKER_SECURE_RPC=https://YOUR_INSTANCE.secure.rpc.solanatracker.io
SECURE_RPC_URL=https://YOUR_INSTANCE.secure.rpc.solanatracker.io
SOLANA_TRACKER_RPC_URL=https://rpc-mainnet.solanatracker.io/?api_key=YOUR_SOLANA_TRACKER_ACCESS_KEY
SOLANA_TRACKER_WSS_URL=wss://rpc-mainnet.solanatracker.io/?api_key=YOUR_SOLANA_TRACKER_ACCESS_KEY
WSS_URL=wss://rpc-mainnet.solanatracker.io/?api_key=YOUR_SOLANA_TRACKER_ACCESS_KEY
SOLANA_TRACKER_ACCESS_KEY=YOUR_SOLANA_TRACKER_ACCESS_KEY
ACCESS_KEY=YOUR_SOLANA_TRACKER_ACCESS_KEY
# Data API (x-api-key on https://data.solanatracker.io). Never fall back to ACCESS_KEY.
SOLANA_TRACKER_API_KEY=YOUR_SOLANA_TRACKER_DATA_API_KEY
SOLANA_TRACKER_DATA_URL=https://data.solanatracker.io

# --- Birdeye (secondary market data) ---
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY
BIRDEYE_WSS_URL=wss://public-api.birdeye.so/socket/solana?x-api-key=YOUR_BIRDEYE_API_KEY

# --- Jupiter Swap v1 / Price v3 / Tokens v2 ---
# Docs: https://developers.jup.ag/docs/llms.txt  (dev.jup.ag redirects here)
JUPITER_API_KEY=YOUR_JUPITER_API_KEY
JUP_SWAP_V1_API_KEY=YOUR_JUPITER_API_KEY
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# Optional: OpenAI API key for image generation
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# Optional: Custom keypair storage path (defaults to .keys in project root)
KEYS_FOLDER=

# Optional: Existing private key (base58 encoded)
# Only use this if you want to import an existing wallet
PRIVATE_KEY=

# Composio Platform (sessions + trigger webhook)
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=ac_EdR4Tipqa6GG
COMPOSIO_WHITELABEL_ORIGINS=https://solgpt.trade,https://x402.life,https://mcp.solgpt.trade
COMPOSIO_SESSION_TOOLKITS=
COMPOSIO_WAIT_FOR_CONNECTIONS=true
# COMPOSIO_DISABLE_TWITTER=true
COMPOSIO_PROJECT_ID=
COMPOSIO_SUB_ID=
COMPOSIO_SIGNING_SECRET=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_URL=https://solgpt.us/api/composio/triggers
COMPOSIO_CLAWD_WS_URL=https://clawd-ws.fly.dev

